# Operator-only admin provisioning. Copy to .env.local and fill in privately.
# Never prefix these values with NEXT_PUBLIC_ or expose them in client code.
# This project must match cliniq-backend's JWT_ISSUER_URI, otherwise the
# backend rejects the access token with 401 (different issuer/signing key).
NEXT_PUBLIC_SUPABASE_URL=https://lschxmlbvubrvefvwlvv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_8fM9D3diYhfeBDz4Afq1-w_x3BEoBMo
NEXT_PUBLIC_API_URL=http://localhost:8080
SUPABASE_SERVICE_ROLE_KEY=
CLINIQ_ADMIN_EMAIL=
CLINIQ_ADMIN_PASSWORD=
CLINIQ_ADMIN_FIRST_NAME=
CLINIQ_ADMIN_LAST_NAME=
# UUID of a department that already exists in the backend's department table.
CLINIQ_ADMIN_DEPARTMENT_ID=
